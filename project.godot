; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Gameboy"
run/main_scene="uid://sc4be44blh86"
config/features=PackedStringArray("4.5", "Forward Plus")

[autoload]

Inventory="*res://scenes/game/inventory.tscn"
MusicPlayer="*res://scenes/game/music_player.tscn"
AreaManager="*res://scenes/game/area_manager.tscn"

[display]

window/size/viewport_width=160
window/size/viewport_height=144
window/size/window_width_override=640
window/size/window_height_override=576
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdLinter/plugin.cfg", "res://addons/gdgdtoolkit/plugin.cfg", "res://addons/gdscript_refactoring/plugin.cfg")

